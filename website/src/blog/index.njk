{# Head, nav, footer, and scroll reveal come from the base layout.
   Cards are hand-written for now. Phase 3 generates them from the posts. #}
{% extends "layouts/base.njk" %}

{% block head %}
  <style>
    .bl-hero {
      padding: 150px 24px 56px;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }
    .bl-hero h1 {
      font-family: var(--font-display);
      font-size: clamp(34px, 5vw, 52px);
      font-weight: 600;
      line-height: 1.15;
      margin-bottom: 12px;
    }
    .bl-hero p { color: var(--text-2); font-size: 17px; }

    .bl-list {
      max-width: 760px;
      margin: 0 auto;
      padding: 56px 24px 96px;
      display: grid;
      gap: 24px;
    }

    /* One card per post. Newest first. */
    .bl-card {
      display: block;
      padding: 32px 30px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .bl-card:hover {
      border-color: rgba(200, 169, 110, 0.25);
      box-shadow: 0 0 40px rgba(200, 169, 110, 0.05);
    }
    .bl-card-kicker {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 10px;
    }
    .bl-card h2 {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 600;
      line-height: 1.2;
      margin-bottom: 10px;
    }
    .bl-card p { font-size: 15px; color: var(--text-2); line-height: 1.65; margin-bottom: 14px; }
    .bl-card-meta { font-size: 13px !important; color: var(--text-3) !important; margin-bottom: 0 !important; }
  </style>
{% endblock %}

{% block content %}
  <header class="bl-hero">
    <p class="mc-kicker">MomentCast Blog</p>
    <h1>Notes from the Stream</h1>
    <p>Guides for photographers and videographers who stream real events.</p>
  </header>

  <main class="bl-list">
    <a class="bl-card" href="/blog/livestream-event-guide">
      <p class="bl-card-kicker">Guide</p>
      <h2>How to Livestream an Event with MomentCast</h2>
      <p>From your first free test stream to downloading the final recording, in the order you'll actually do it. Works with OBS, vMix, Wirecast, or any RTMPS encoder.</p>
      <p class="bl-card-meta">Aaron Alvarez &nbsp;&middot;&nbsp; October 23, 2026 &nbsp;&middot;&nbsp; 15 min read</p>
    </a>

    <a class="bl-card" href="/blog/how-to-watch">
      <p class="bl-card-kicker">For Guests</p>
      <h2>How to Watch a MomentCast Live Stream</h2>
      <p>Got a link to someone's big day? How to turn on the sound, watch on a TV, and catch the replay.</p>
      <p class="bl-card-meta">October 24, 2026 &nbsp;&middot;&nbsp; 3 min read</p>
    </a>
  </main>

{% endblock %}