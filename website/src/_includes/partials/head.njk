  <!-- Shared <head>. Pages set title and description in front matter.
       Canonical is built from the page URL, minus .html and index.html. -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="canonical" href="{{ site.url }}{{ page.url | cleanUrl }}">
  <meta name="description" content="{{ description }}">
  {%- if ogTitle %}

  <!-- OG Tags (only on pages that set ogTitle) -->
  <meta property="og:title" content="{{ ogTitle }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url | cleanUrl }}">
  <meta property="og:image" content="{{ site.url }}/og-preview.png">
  <meta name="twitter:card" content="summary_large_image">
  {%- endif %}

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png">

  <!-- Fonts: one weight set for every page -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">

  <!-- Shared stylesheet. Absolute path so it resolves from /blog/ too. -->
  <link rel="stylesheet" href="/style.css?v={{ buildTime }}">


  {#- Consent Mode v2 (advanced). The default MUST be set before config.
      Reads the mc_consent cookie written by partials/consent.njk, so visitors
      who already accepted are granted from their first hit. Ad signals stay
      denied permanently: MomentCast runs no ads. Until a visitor accepts,
      GA sets no cookies and only sends cookieless pings. #}
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: /(?:^|;\s*)mc_consent=granted(?:;|$)/.test(document.cookie) ? 'granted' : 'denied'
    });
    gtag('js', new Date());
    gtag('config', '{{ site.gaId }}');
  </script>
  <!-- Google tag (gtag.js). Marketing site property only, never the watch-page ID. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>