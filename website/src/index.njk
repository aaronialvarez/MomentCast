{% block scripts %}
  <script>
    // Pricing estimator. Same math as the dashboard's create-event page:
    // hours = duration x viewers, 250 hours per credit, $30 per credit at list price.
    // Keep HOURS_PER_CREDIT in sync with MINUTES_PER_CREDIT / 60 in worker.ts.
    // Wrapped in an IIFE so nothing leaks to the global scope.
    (function () {
      var HOURS_PER_CREDIT = 250;
      var PRICE_PER_CREDIT = 30;

      var dur = document.getElementById('est-duration');
      var view = document.getElementById('est-viewers');
      if (!dur || !view) return; // markup missing: do nothing rather than throw

      var durOut = document.getElementById('est-duration-out');
      var viewOut = document.getElementById('est-viewers-out');
      var hoursOut = document.getElementById('est-hours-out');
      var creditsOut = document.getElementById('est-credits-out');
      var priceOut = document.getElementById('est-price-out');
      var detailOut = document.getElementById('est-detail-out');

      function render() {
        var d = parseFloat(dur.value);
        var v = parseInt(view.value, 10);
        var hours = Math.round(d * v);
        var credits = Math.max(1, Math.ceil(hours / HOURS_PER_CREDIT));

        // Leftover hours across all credits, and how many extra viewers that absorbs
        // if each watched the full stream. d is never below 0.5, so no divide-by-zero.
        var headroom = credits * HOURS_PER_CREDIT - hours;
        var extraViewers = Math.floor(headroom / d);

        durOut.textContent = d.toFixed(1) + ' hour' + (d !== 1 ? 's' : '');
        viewOut.textContent = v;
        hoursOut.textContent = hours.toLocaleString('en-US') + ' hrs';
        creditsOut.textContent = credits + ' credit' + (credits !== 1 ? 's' : '');
        priceOut.textContent = '$' + (credits * PRICE_PER_CREDIT);

        var detail = headroom + ' hour' + (headroom !== 1 ? 's' : '') + ' of headroom for replays';
        if (extraViewers >= 1) {
          detail += ' or for ' + extraViewers + ' more unexpected live viewer' + (extraViewers !== 1 ? 's' : '');
        }
        detailOut.textContent = detail + '.';
      }

      dur.addEventListener('input', render);
      view.addEventListener('input', render);
      render();
    })();
  </script>

